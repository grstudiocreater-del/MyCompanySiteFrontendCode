# Copy to .env.local and fill in. Never commit real secrets.
# Brand and contact details (GR Studio Creator, email, legal info) live in lib/brand.ts.

# Public site URL — used for canonical URLs, sitemap, robots and Open Graph tags.
# Overrides brand.website in lib/brand.ts.
NEXT_PUBLIC_SITE_URL=https://grstudiocreaterweb.grstudiocreater.workers.dev

# --- Contact form delivery (server-only; configure ONE option) ---
# Without either, the form shows an error asking visitors to email you directly.

# Option A: send email through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified with Resend, e.g. "Website <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Option B: POST each submission as JSON to a webhook (automation tool, chat, form backend…)
CONTACT_WEBHOOK_URL=
