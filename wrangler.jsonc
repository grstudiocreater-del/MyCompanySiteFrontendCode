{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grstudiocreaterweb",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "grstudiocreaterweb"
    }
  ],
  "vars": {
    "CONTACT_FROM_EMAIL": "GR Studio Creator <onboarding@resend.dev>",
    "NEXT_PUBLIC_SITE_URL": "https://grstudiocreaterweb.grstudiocreater.workers.dev"
  }
}
